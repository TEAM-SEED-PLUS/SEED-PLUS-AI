.git
.gitignore
.env
.env.*
.venv
venv
__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
tests
docs

# Include data/ in the image. Runtime scheduler checkpoints and temporary
# writes belong to the running application, not the static dataset.
data/**/.env
data/**/.env.*
data/**/*.tmp
data/raw/living_population/.incoming-*.zip
data/hongdae/scheduler_state.json
data/hongdae/.*.lock
data/weather_overview/.collector.lock
data/weather_overview/.collector-state.json
# Runtime retention removes expired snapshots. Do not seed them again.
data/weather_overview/latest
